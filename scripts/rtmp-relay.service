[Unit]
Description=Sangluwoo 摄像机 RTSP -> RTMP 转发
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 摄像机 IP 由脚本按 MAC 自动探测; 需要固定时再设置 CAM_IP
Environment=CAM_MAC=00:9A:7A:45:00:D7
Environment=RTMP_URL=rtmp://wrjxk.app.xmschain.com:1935/UAV/UAV00002/19yqM1eMpAVLSpD2S6Ej
Environment=MODE=auto
Environment=SRC_CODEC=hevc
Environment=RTSP_TRANSPORT=tcp
# 守护: 每 5s 检查一次; 连续 10s 没有数据发出即判定卡死, 退出后由 Restart 重启;
# 正常时每 30s 打一次心跳
Environment=WATCHDOG_SEC=5
Environment=STALL_SEC=10
Environment=HEARTBEAT_SEC=30
ExecStart=/usr/local/bin/rtmp_relay.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
